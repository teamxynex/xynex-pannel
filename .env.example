# Server Configuration
# Main Panel Production Port
PORT=6767

# Development Port (Disabled by default. Uncomment to use dev port 3000)
# PORT=3000
# VITE_ENABLE_DEV_MODE=true

# DANGER: only set this to "true" in local development. When enabled
# (and NODE_ENV is not "production"), logging in with a username that
# doesn't exist yet silently creates a new admin account with whatever
# password was typed. Never enable this on a public/production panel.
# ALLOW_DEV_AUTO_LOGIN=true

# Must be a long, random, secret value in production - used to sign login
# tokens. If left unset the panel falls back to an insecure default and
# prints a warning on startup.
JWT_SECRET="your-secure-random-jwt-secret-here"

# Gemini AI API Key (Optional, kept server-side)
GEMINI_API_KEY="your-gemini-api-key"

# Container Engine Configuration (docker or podman)
CONTAINER_ENGINE=podman
DOCKER_SOCKET_PATH=
